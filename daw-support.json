  "tiers": [
    {
      "id": "advanced",
      "label": "Advanced",
      "summary": "Direct parameter control",
      "description": "Everything in Enhanced, plus hands-on control of the mix.",
      "features": [
        {
          "title": "Direct parameter control",
          "detail": "Controls are adjusted at their source rather than by steering a mouse pointer around the screen, so each finger works on its own parameter at the same time."
        },
        {
          "title": "Multi-touch faders",
          "detail": "Ride several channel faders together, one finger each, the way you would on a physical console."
        },
        {
          "title": "Multi-touch encoders and pans",
          "detail": "Adjust more than one knob, pan or send at once instead of reaching for them one after another."
        },
        {
          "title": "Multi-touch buttons",
          "detail": "Mute, solo or bypass several channels together with a single movement of the hand."
        }
      ]
    },
    {
      "id": "enhanced",
      "label": "Enhanced",
      "summary": "Gestures tuned to the app",
      "description": "Everything in Basic, plus gestures the driver has been taught for this particular application.",
      "features": [
        {
          "title": "Zoom that knows the application",
          "detail": "Pinching drives the application's own zoom rather than a generic shortcut, so it zooms the arrangement instead of the interface."
        },
        {
          "title": "Separate horizontal and vertical zoom",
          "detail": "Pinch sideways to stretch the timeline and vertically to change track height, where the application offers both."
        },
        {
          "title": "Multi-touch buttons",
          "detail": "Where the application exposes them, buttons such as mute and solo respond to more than one finger at a time."
        }
      ]
    },
    {
      "id": "basic",
      "label": "Basic",
      "summary": "Precision touch",
      "universal": true,
      "description": "Applies to every application on your Mac, whether or not it is listed here. The application responds to touch exactly as it would to a precision mouse.",
      "features": [
        {
          "title": "Tap to click",
          "detail": "A tap clicks precisely where your finger lands, with no offset to correct for."
        },
        {
          "title": "Touch and drag",
          "detail": "Press and move to drag faders, regions, clips or anything else you would drag with a mouse."
        },
        {
          "title": "Double tap",
          "detail": "Opens, renames or resets, following whatever the application already does on a double click."
        },
        {
          "title": "Hold to right-click",
          "detail": "Rest a finger for a moment to open the context menu, without reaching for a mouse or keyboard."
        },
        {
          "title": "Two-finger scroll",
          "detail": "Scroll through a mixer, a track list or a long arrangement with two fingers."
        },
        {
          "title": "Pinch to zoom",
          "detail": "Pinching zooms in any application that follows the standard macOS zoom shortcut."
        }
      ]
    }
  ],
